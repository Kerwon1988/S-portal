{
  "request": {
    "method": "POST",
    "urlPath": "/api/platform/v1/owner-onboardings/1001/activation-links",
    "headers": {
      "X-Platform-Key-Id": { "equalTo": "portal-contract-test" },
      "X-Platform-Timestamp": { "matches": "^[0-9]{10}$" },
      "X-Platform-Signature": { "matches": "^v1=[a-f0-9]{64}$" },
      "Idempotency-Key": { "matches": "^[A-Za-z0-9._:-]{16,128}$" }
    }
  },
  "response": {
    "status": 201,
    "headers": {
      "Content-Type": "application/json",
      "Cache-Control": "no-store"
    },
    "jsonBody": {
      "activationUrl": "https://portal.invalid/activate/{redacted}",
      "expiresAt": "2030-01-01T00:15:00Z"
    }
  }
}
