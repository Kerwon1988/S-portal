{
  "name": "s-portal-frontend",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "build": "npm run css:build && node scripts/fingerprint-assets.mjs",
    "css:build": "tailwindcss -i src/main/frontend/css/app.css -o target/frontend/app.css --minify",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@alpinejs/csp": "3.17.5",
    "htmx.org": "2.0.11"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.62.1",
    "postcss-import": "15.1.0",
    "tailwindcss": "3.4.19"
  }
}
